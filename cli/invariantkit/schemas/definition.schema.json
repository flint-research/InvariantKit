{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "InvariantKit definition catalog",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "definitions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "definitions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "$ref": "#/$defs/definition"
      }
    }
  },
  "$defs": {
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "category",
        "adapter",
        "assertion",
        "targets",
        "assumptions"
      ],
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 120,
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+(?![\\s\\S])"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "category": {
          "enum": [
            "standard",
            "accounting",
            "protocol"
          ]
        },
        "adapter": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[a-z][a-z0-9-]*(?![\\s\\S])"
        },
        "assertion": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "properties": {
            "kind": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "operation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "relation": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "tolerance": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "absolute",
                "unit"
              ],
              "properties": {
                "absolute": {
                  "type": "string",
                  "maxLength": 78,
                  "pattern": "^(?:0|[1-9][0-9]*)(?![\\s\\S])"
                },
                "unit": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 160
                }
              }
            }
          }
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "ref"
            ],
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            }
          }
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "maxItems": 64,
          "uniqueItems": true
        },
        "preconditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "maxItems": 64,
          "uniqueItems": true
        },
        "parameters": {
          "type": "object",
          "maxProperties": 64
        },
        "tolerances": {
          "type": "object",
          "maxProperties": 64,
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "absolute",
              "unit"
            ],
            "properties": {
              "absolute": {
                "type": "string",
                "maxLength": 78,
                "pattern": "^(?:0|[1-9][0-9]*)(?![\\s\\S])"
              },
              "unit": {
                "type": "string",
                "minLength": 1,
                "maxLength": 160
              }
            }
          }
        },
        "actions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "maxItems": 64,
          "uniqueItems": true
        },
        "fork": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "chain_id",
            "block_number",
            "block_hash"
          ],
          "properties": {
            "chain_id": {
              "type": "integer",
              "minimum": 1
            },
            "block_number": {
              "type": "integer",
              "minimum": 0
            },
            "block_hash": {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{64}(?![\\s\\S])"
            }
          }
        },
        "source_references": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 1024,
            "pattern": "^https://[^\\s]+(?![\\s\\S])"
          },
          "maxItems": 64,
          "uniqueItems": true
        },
        "expected_result": {
          "enum": [
            "pass",
            "fail"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "maxItems": 64,
          "uniqueItems": true
        },
        "forge": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "suite",
            "test",
            "kind"
          ],
          "properties": {
            "suite": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "test": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            "kind": {
              "enum": [
                "unit",
                "fuzz",
                "invariant"
              ]
            },
            "coverage": {
              "type": "object",
              "additionalProperties": false,
              "required": [],
              "properties": {
                "required_calls": {
                  "type": "object",
                  "maxProperties": 64,
                  "propertyNames": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 512
                  },
                  "additionalProperties": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 4294967295
                  }
                },
                "custom_errors": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 120,
                    "pattern": "^[A-Za-z_][A-Za-z0-9_]*(?![\\s\\S])"
                  },
                  "maxItems": 64,
                  "uniqueItems": true
                },
                "zero_assertions": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 160
                  },
                  "maxItems": 64,
                  "uniqueItems": true
                }
              }
            }
          }
        }
      }
    }
  }
}
